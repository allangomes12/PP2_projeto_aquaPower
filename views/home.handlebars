<div class="home">

    {{#if mensagem}}

    <div class="alerta-central" id="alertaCentral" role="status">

        <i class="fa-solid fa-circle-check" aria-hidden="true"></i>

        {{#if (eq mensagem "cadastrado")}}
        <span>Consumo cadastrado</span>
        {{else if (eq mensagem "editado")}}
        <span>Consumo editado</span>
        {{else if (eq mensagem "excluido")}}
        <span>Consumo excluído</span>
        {{/if}}

    </div>

    {{/if}}

    <!-- ============================= -->
    <!-- HERO -->
    <!-- ============================= -->

    <section class="hero">

        <h1>
            Bem-vindo ao
            <span class="aqua">Aqua</span><span class="power">Power!</span>
        </h1>

        <p>
            Acompanhe seu consumo de água e energia de forma simples e eficiente.
        </p>

    </section>


    <!-- ============================= -->
    <!-- DASHBOARD -->
    <!-- ============================= -->

    <div class="dashboard">


        <!-- ========================= -->
        <!-- GRÁFICO -->
        <!-- ========================= -->

        <section class="card card-grafico" aria-labelledby="titulo-grafico">

            <div class="card-titulo">

                <i class="fa-solid fa-chart-simple" aria-hidden="true"></i>

                <h2 id="titulo-grafico">Consumo por Categoria</h2>

            </div>

            <div class="grafico-area">

                <!-- O gráfico é visual; leitores de tela usam a tabela abaixo -->
                <canvas id="graficoConsumo" aria-hidden="true"></canvas>

                <table class="sr-only">
                    <caption>Total de consumo por categoria, em reais</caption>
                    <thead>
                        <tr>
                            <th scope="col">Categoria</th>
                            <th scope="col">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th scope="row">Água</th>
                            <td>R$ {{totalAgua}}</td>
                        </tr>
                        <tr>
                            <th scope="row">Energia</th>
                            <td>R$ {{totalEnergia}}</td>
                        </tr>
                    </tbody>
                </table>

            </div>

        </section>


        <!-- ========================= -->
        <!-- CONSUMOS RECENTES -->
        <!-- ========================= -->

        <section class="card card-consumos" aria-labelledby="titulo-consumos">

            <div class="card-titulo">

                <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>

                <h2 id="titulo-consumos">Consumos Recentes</h2>

            </div>


            <div class="lista-consumos">

                {{#if consumos.length}}

                <ul class="lista-itens">

                    {{#each consumos}}

                    <li class="consumo-item">

                        <!-- ÍCONE -->

                        <div class="consumo-icone {{#if (eq tipo "Água")}}icone-agua{{else}}icone-energia{{/if}}" aria-hidden="true">

                            {{#if (eq tipo "Água")}}
                            <i class="fa-solid fa-droplet"></i>
                            {{else}}
                            <i class="fa-solid fa-lightbulb"></i>
                            {{/if}}

                        </div>

                        <!-- INFORMAÇÕES -->

                        <div class="consumo-info">

                            <strong>{{tipo}}</strong>

                            <span>{{formatDate data}}</span>

                        </div>

                        <!-- VALOR -->

                        <strong class="consumo-valor">

                            R$ {{valor}}

                        </strong>

                        <!-- AÇÕES -->

                        <div class="consumo-acoes">

                            <a href="/consumos/editar/{{id}}" class="acao-editar"
                               aria-label="Editar consumo de {{tipo}} de {{formatDate data}}">
                                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                            </a>

                            <form action="/consumos/excluir/{{id}}" method="POST"
                                  data-confirmar="Excluir o consumo de {{tipo}} de {{formatDate data}}? Esta ação não pode ser desfeita.">

                                <button type="submit" class="acao-excluir"
                                        aria-label="Excluir consumo de {{tipo}} de {{formatDate data}}">
                                    <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                </button>

                            </form>

                        </div>

                    </li>

                    {{/each}}

                </ul>

                {{else}}

                <div class="sem-consumos">

                    <i class="fa-solid fa-chart-column" aria-hidden="true"></i>

                    <p>Nenhum consumo cadastrado.</p>

                    <a href="/consumos/cadastrar">
                        Adicionar primeiro consumo
                    </a>

                </div>

                {{/if}}

            </div>

        </section>

    </div>


    <!-- ============================= -->
    <!-- BOTÃO NOVO CONSUMO -->
    <!-- ============================= -->

    <div class="area-botao-consumo">

        <a href="/consumos/cadastrar" class="btn-novo-consumo">

            <i class="fa-solid fa-plus" aria-hidden="true"></i>

            Novo Consumo

        </a>

    </div>

</div>


<!-- CHART.JS -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    const ctx = document.getElementById("graficoConsumo");

    const reduzirMovimento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (ctx && typeof Chart !== "undefined") {

        new Chart(ctx, {

            type: "bar",

            data: {

                labels: ["Água", "Energia"],

                datasets: [{

                    data: [
                        {{ totalAgua }},
                        {{ totalEnergia }}
                    ],

                    backgroundColor: ["#1688f7", "#ffbf00"],

                    borderColor: ["#1688f7", "#ffbf00"],

                    borderWidth: 0,

                    barThickness: 105

                }]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                animation: reduzirMovimento ? false : undefined,

                layout: {
                    padding: { top: 30, right: 15, left: 10, bottom: 5 }
                },

                plugins: {

                    legend: { display: false },

                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return "R$" + context.raw;
                            }
                        }
                    }

                },

                scales: {

                    x: {
                        grid: { display: false },
                        ticks: { color: "#d1d5db", font: { size: 14 } }
                    },

                    y: {
                        beginAtZero: true,
                        grid: { color: "rgba(148, 163, 184, 0.12)" },
                        ticks: { color: "#cbd5e1", stepSize: 20 },
                        title: {
                            display: true,
                            text: "Valor (R$)",
                            color: "#cbd5e1",
                            font: { size: 14 }
                        }
                    }

                }

            },

            plugins: [

                {

                    id: "valoresEmCima",

                    afterDatasetsDraw(chart) {

                        const { ctx } = chart;

                        ctx.save();

                        chart.data.datasets.forEach((dataset, datasetIndex) => {

                            const meta = chart.getDatasetMeta(datasetIndex);

                            meta.data.forEach((bar, index) => {

                                const valor = dataset.data[index];

                                ctx.fillStyle = index === 0 ? "#1688f7" : "#ffbf00";

                                ctx.font = "14px Arial";

                                ctx.textAlign = "center";

                                ctx.fillText("R$" + valor, bar.x, bar.y - 10);

                            });

                        });

                        ctx.restore();

                    }

                }

            ]

        });

    }

</script>

<script>

    const alerta = document.getElementById("alertaCentral");

    if (alerta) {

        // 6 segundos para dar tempo de ler a mensagem
        setTimeout(() => {

            alerta.classList.add("saindo");

            setTimeout(() => {
                alerta.remove();
            }, 400);

        }, 6000);

    }

</script>

<script>

    // confirmação antes de excluir um consumo
    document.querySelectorAll("form[data-confirmar]").forEach(form => {

        form.addEventListener("submit", evento => {

            if (!confirm(form.dataset.confirmar)) {
                evento.preventDefault();
            }

        });

    });

</script>