<div class="pagina-tabela">

{{> abas ativoOcultos=true}}

<section class="titulo">
    <h1>Equipamentos Ocultos</h1>
    <p>Restaure equipamentos ocultados para que voltem à lista principal.</p>
</section>

<div class="tabela-container" role="region" aria-labelledby="legenda-tabela" tabindex="0">

<table>

<caption id="legenda-tabela" class="sr-only">
    Lista de equipamentos ocultos, com categoria, consumo mensal de energia e água, e a ação de restaurar.
</caption>

<thead>
<tr>
    <th scope="col">Equipamento</th>
    <th scope="col">Categoria</th>
    <th scope="col">Energia</th>
    <th scope="col">Água</th>
    <th scope="col">Ação</th>
</tr>
</thead>

<tbody>

{{#each equipamentos}}

<tr>
    <th scope="row" class="nome-linha">{{nome}}</th>
    <td>{{categoria}}</td>
    <td>{{consumoEnergia}} kWh/mês</td>
    <td>{{consumoAgua}} L/mês</td>
    <td>
        <form action="/restaurar/{{id}}" method="POST">
            <button type="submit" class="restaurar" aria-label="Restaurar {{nome}}">
                Restaurar
            </button>
        </form>
    </td>
</tr>

{{/each}}

{{#unless equipamentos}}
<tr>
    <td colspan="5">Nenhum equipamento oculto.</td>
</tr>
{{/unless}}

</tbody>

</table>

</div>

</div>