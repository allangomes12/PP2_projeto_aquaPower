<div class="pagina-tabela">

{{> abas ativoEquipamentos=true}}

<section class="titulo">
    <h1>Equipamentos</h1>
    <p>Consulte, cadastre, edite e oculte equipamentos.</p>
</section>

<section class="cadastro" aria-labelledby="titulo-form">

<h2 id="titulo-form">{{#if equipamentoEditar}}Editar Equipamento{{else}}Novo Equipamento{{/if}}</h2>

<form action="{{#if equipamentoEditar}}/eletrodomesticos/editar/{{equipamentoEditar.id}}{{else}}/eletrodomesticos{{/if}}" method="POST">

    <div class="campo-cadastro">
        <label for="nome">Nome do equipamento</label>
        <input type="text" id="nome" name="nome" value="{{equipamentoEditar.nome}}"
               minlength="2" maxlength="100" autocomplete="off"
               aria-describedby="dica-nome" required>
        <small id="dica-nome" class="dica">Obrigatório. Ex.: Geladeira.</small>
    </div>

    <div class="campo-cadastro">
        <label for="categoria">Categoria</label>
        <select id="categoria" name="categoria" aria-describedby="dica-categoria" required>
            <option value="">Selecione uma categoria</option>
            <option value="Cozinha" {{#if (eq equipamentoEditar.categoria "Cozinha")}}selected{{/if}}>Cozinha</option>
            <option value="Lavanderia" {{#if (eq equipamentoEditar.categoria "Lavanderia")}}selected{{/if}}>Lavanderia</option>
            <option value="Climatização" {{#if (eq equipamentoEditar.categoria "Climatização")}}selected{{/if}}>Climatização</option>
            <option value="Entretenimento" {{#if (eq equipamentoEditar.categoria "Entretenimento")}}selected{{/if}}>Entretenimento</option>
            <option value="Informática" {{#if (eq equipamentoEditar.categoria "Informática")}}selected{{/if}}>Informática</option>
            <option value="Limpeza" {{#if (eq equipamentoEditar.categoria "Limpeza")}}selected{{/if}}>Limpeza</option>
            <option value="Água" {{#if (eq equipamentoEditar.categoria "Água")}}selected{{/if}}>Água</option>
            <option value="Banheiro" {{#if (eq equipamentoEditar.categoria "Banheiro")}}selected{{/if}}>Banheiro</option>
            <option value="Cuidados pessoais" {{#if (eq equipamentoEditar.categoria "Cuidados pessoais")}}selected{{/if}}>Cuidados pessoais</option>
        </select>
        <small id="dica-categoria" class="dica">Obrigatório. Escolha uma opção da lista.</small>
    </div>

    <div class="campo-cadastro">
        <label for="consumoEnergia">Energia (kWh/mês)</label>
        <input type="number" id="consumoEnergia" name="consumoEnergia" value="{{equipamentoEditar.consumoEnergia}}"
               step="0.01" min="0" inputmode="decimal"
               aria-describedby="dica-energia" required>
        <small id="dica-energia" class="dica">Obrigatório. Número maior ou igual a 0.</small>
    </div>

    <div class="campo-cadastro">
        <label for="consumoAgua">Água (L/mês)</label>
        <input type="number" id="consumoAgua" name="consumoAgua" value="{{equipamentoEditar.consumoAgua}}"
               step="0.01" min="0" inputmode="decimal"
               aria-describedby="dica-agua" required>
        <small id="dica-agua" class="dica">Obrigatório. Número maior ou igual a 0 (use 0 se não consome água).</small>
    </div>

    <div class="acoes-form">
        <button type="submit">
            {{#if equipamentoEditar}}Salvar Alterações{{else}}Cadastrar{{/if}}
        </button>

        {{#if equipamentoEditar}}
        <a href="/eletrodomesticos" class="cancelar">Cancelar</a>
        {{/if}}
    </div>

</form>

</section>

<div class="tabela-container" role="region" aria-labelledby="legenda-tabela" tabindex="0">

<table>

<caption id="legenda-tabela" class="sr-only">
    Lista de equipamentos cadastrados, com categoria, consumo mensal de energia e água, e ações de editar e ocultar.
</caption>

<thead>
<tr>
    <th scope="col">Equipamento</th>
    <th scope="col">Categoria</th>
    <th scope="col">Energia</th>
    <th scope="col">Água</th>
    <th scope="col">Ações</th>
</tr>
</thead>

<tbody>

{{#each equipamentos}}

<tr>
    <th scope="row" class="nome-linha">{{nome}}</th>
    <td>{{categoria}}</td>
    <td>{{consumoEnergia}} kWh/mês</td>
    <td>{{consumoAgua}} L/mês</td>

    <td>
        <div class="acoes">

            <a href="/eletrodomesticos/editar/{{id}}" class="editar" aria-label="Editar {{nome}}">
                Editar
            </a>

            <form action="/ocultar/{{id}}" method="POST">
                <button type="submit" class="ocultar" aria-label="Ocultar {{nome}}">
                    Ocultar
                </button>
            </form>

        </div>
    </td>
</tr>

{{/each}}

</tbody>

</table>

</div>

<p class="aviso-reversivel">
    Equipamentos ocultados não são excluídos: você pode restaurá-los na aba “Equipamentos Ocultos”.
</p>

</div>