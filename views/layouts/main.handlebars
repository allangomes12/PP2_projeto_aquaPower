<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{#if title}}{{title}} | AquaPower{{else}}AquaPower{{/if}}</title>

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <!-- CSS do H2/H3 -->
    <link rel="stylesheet" href="/css/home.css">

    <!-- CSS do H4 -->
    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <a href="#conteudo" class="pular-conteudo">Pular para o conteúdo principal</a>

    <header class="header">

        <div class="header-container">

            <!-- LOGO -->

            <a href="/" class="logo" aria-label="AquaPower - página inicial">

                <div class="logo-icone" aria-hidden="true">

                    <i class="fa-solid fa-droplet logo-agua"></i>

                    <i class="fa-solid fa-bolt logo-energia"></i>

                </div>

                <div class="logo-texto">

                    <span class="logo-aqua">Aqua</span><span class="logo-power">Power</span>

                </div>

            </a>

            <!-- MENU -->

            <nav class="menu" aria-label="Navegação principal">

                <a href="/" class="menu-item{{#if (eq pagina "inicio")}} ativo{{/if}}" {{#if (eq pagina "inicio")}}aria-current="page"{{/if}}>

                    <i class="fa-solid fa-house" aria-hidden="true"></i>

                    <span>Início</span>

                </a>

                <a href="/eletrodomesticos" class="menu-item{{#if (eq pagina "equipamentos")}} ativo{{/if}}" {{#if (eq pagina "equipamentos")}}aria-current="page"{{/if}}>

                    <i class="fa-regular fa-square" aria-hidden="true"></i>

                    <span>Equipamentos</span>

                </a>

                <a href="/consumos" class="menu-item{{#if (eq pagina "consumos")}} ativo{{/if}}" {{#if (eq pagina "consumos")}}aria-current="page"{{/if}}>

                    <i class="fa-regular fa-clock" aria-hidden="true"></i>

                    <span>Consumos</span>

                </a>

                <a href="#" class="menu-item">

                    <i class="fa-solid fa-circle-info" aria-hidden="true"></i>

                    <span>Sobre</span>

                </a>

            </nav>

        </div>

    </header>

    <main id="conteudo" tabindex="-1">

        {{{body}}}

    </main>

</body>

</html>